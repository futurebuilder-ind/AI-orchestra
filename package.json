{
  "name": "ai-orchestra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "node backend/node_modules/typescript/bin/tsc -p backend/tsconfig.json && node backend/dist/server.js",
    "dev:frontend": "node frontend/node_modules/vite/bin/vite.js --config frontend/vite.config.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "node backend/node_modules/typescript/bin/tsc -p backend/tsconfig.json",
    "build:frontend": "node backend/node_modules/typescript/bin/tsc -p frontend/tsconfig.json && node frontend/node_modules/vite/bin/vite.js build --config frontend/vite.config.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "node backend/node_modules/typescript/bin/tsc -p backend/tsconfig.json && node backend/dist/tests/run-tests.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
